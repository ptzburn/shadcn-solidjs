{
  "tasks": {
    "dev": "deno run --allow-env --allow-sys --allow-ffi --env-file --allow-net --allow-read --allow-write --allow-run vite --port 3228",
    "build": "deno task build:registry && deno run -A npm:vite build",
    "build:registry": "deno run -A ./src/scripts/build-icons.ts && deno run -A ./src/scripts/build-registry.ts && deno run -A ./src/scripts/build-docs-tokens.ts && deno fmt ./src/__registry__ ./src/registry/icons ./src/styles/style-docs.css",
    "start": "deno run --allow-net --allow-read --allow-write --allow-ffi --allow-env --allow-sys ./.output/server/index.mjs",
    "release": "changeset version",
    "check": "deno fmt ./src/ && deno lint ./src/ && deno check ./src/",
    "lint": "deno lint ./src/"
  },
  "imports": {
    "@ark-ui/solid": "npm:@ark-ui/solid@^5.38.0",
    "@corvu/calendar": "npm:@corvu/calendar@^0.1.2",
    "@corvu/drawer": "npm:@corvu/drawer@^0.2.4",
    "@corvu/otp-field": "npm:@corvu/otp-field@^0.1.4",
    "@corvu/resizable": "npm:@corvu/resizable@^0.2.5",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3",
    "@iconify-json/lucide": "npm:@iconify-json/lucide@^1.2.121",
    "@iconify-json/simple-icons": "npm:@iconify-json/simple-icons@^1.2.93",
    "@iconify-json/tabler": "npm:@iconify-json/tabler@^1.2.38",
    "@iconify-json/ph": "npm:@iconify-json/ph@^1.2.2",
    "@iconify-json/ri": "npm:@iconify-json/ri@^1.2.10",
    "@iconify-json/hugeicons": "npm:@iconify-json/hugeicons@^1.2.32",
    "@kobalte/core": "npm:@kobalte/core@^0.13.12",
    "@kobalte/tailwindcss": "npm:@kobalte/tailwindcss@^0.9.0",
    "@mdx-js/mdx": "npm:@mdx-js/mdx@^3.1.1",
    "@mdx-js/rollup": "npm:@mdx-js/rollup@^3.1.1",
    "@modular-forms/solid": "npm:@modular-forms/solid@^0.25.1",
    "@solid-primitives/keyboard": "npm:@solid-primitives/keyboard@^1.3.7",
    "@solid-primitives/refs": "npm:@solid-primitives/refs@^1.1.4",
    "@solid-primitives/storage": "npm:@solid-primitives/storage@^4.4.0",
    "@solidjs/meta": "npm:@solidjs/meta@^0.29.4",
    "@solidjs/router": "npm:@solidjs/router@^1.0.0",
    "@solidjs/start": "npm:@solidjs/start@2.0.0-rc.9",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "@tanstack/solid-table": "npm:@tanstack/solid-table@^9.0.0",
    "@types/node": "npm:@types/node@^26.1.2",
    "@types/unist": "npm:@types/unist@^3.0.3",
    "unist": "npm:@types/unist@^3.0.3",
    "chart.js": "npm:chart.js@^4.5.1",
    "chrono-node": "npm:chrono-node@^2.8.2",
    "class-variance-authority": "npm:class-variance-authority@^0.7.1",
    "cmdk-solid": "npm:cmdk-solid@^1.1.2",
    "embla-carousel-autoplay": "npm:embla-carousel-autoplay@^8.6.0",
    "embla-carousel-solid": "npm:embla-carousel-solid@^8.6.0",
    "estree-util-value-to-estree": "npm:estree-util-value-to-estree@^3.5.0",
    "nitro": "npm:nitro@3.0.260610-beta",
    "postcss": "npm:postcss@^8.5.25",
    "rehype-pretty-code": "npm:rehype-pretty-code@^0.14.5",
    "rehype-slug": "npm:rehype-slug@^6.0.0",
    "remark-frontmatter": "npm:remark-frontmatter@^5.0.0",
    "remark-gfm": "npm:remark-gfm@^4.0.1",
    "shiki": "npm:shiki@^4.4.1",
    "shosho": "npm:shosho@^1.4.3",
    "solid-js": "npm:solid-js@^1.9.14",
    "solid-mdx": "npm:solid-mdx@^0.0.7",
    "solid-sonner": "npm:solid-sonner@^0.3.1",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "tw-animate-css": "npm:tw-animate-css@^1.4.0",
    "undici": "npm:undici@^8.10.0",
    "unist-builder": "npm:unist-builder@^4.0.0",
    "unist-util-visit": "npm:unist-util-visit@^5.1.0",
    "unplugin-icons": "npm:unplugin-icons@^23.0.1",
    "valibot": "npm:valibot@^1.4.2",
    "vite": "npm:vite@^8.2.0",
    "yaml": "npm:yaml@^2.9.0",
    "~/": "./src/",
    "clsx": "npm:clsx@^2.1.1",
    "tailwind-merge": "npm:tailwind-merge@^3.6.0"
  },
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "esnext",
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
    "strict": true,
    "types": [
      "vite/client",
      "unplugin-icons/types/solid"
    ]
  }
}
