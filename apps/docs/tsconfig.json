{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",

    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,

    // Type Checking & Safety
    "strict": true,
    "skipLibCheck": true,
    // Sources import siblings with explicit .ts/.tsx extensions.
    "allowImportingTsExtensions": true,
    // Not unplugin-icons/types/solid: see src/icons.d.ts.
    "types": ["vite/client"],

    // Source mappings the Vite config mirrors in resolve.alias
    "paths": {
      "~/*": ["./src/*"],
      "@ptzburn/shadcn-solid/message-scroller": [
        "../../packages/solid/src/message-scroller/index.ts"
      ]
    }
  },
  "include": ["src", "scripts", "vite.config.ts"]
}
