{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",

    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,

    // Type Checking & Safety
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "unplugin-icons/types/solid"],

    // Source mappings the Vite config mirrors in resolve.alias
    "paths": {
      "~/*": ["./src/*"],
      "~icons/*": ["./node_modules/unplugin-icons/types/solid.d.ts"],
      "@ptzburn/shadcn-solid/message-scroller": [
        "../../packages/solid/src/message-scroller/index.ts"
      ]
    }
  }
}
