{
  "name": "shadcn-solidjs",
  "version": "0.0.1",
  "description": "A set of beautifully designed components that you can customize, extend, and build on.",
  "type": "module",
  "scripts": {
    "dev": "deno run --allow-env --allow-sys --allow-ffi --env-file --allow-net --allow-read --allow-write --allow-run npm:vite --port 3228",
    "build": "deno task build:registry && deno run -A npm:vite build",
    "start": "deno run -A npm:vite preview --port 3228",
    "release": "changeset version",
    "build:registry": "deno run -A ./src/scripts/build-icons.ts && deno run -A ./src/scripts/build-registry.ts && deno run -A ./src/scripts/build-docs-tokens.ts && deno fmt ./src/__registry__ ./src/registry/icons ./src/styles/style-docs.css",
    "check": "deno fmt ./src/ && deno lint ./src/ && deno check ./src/",
    "lint": "deno lint ./src/"
  },
  "license": "MIT",
  "devDependencies": {
    "@iconify-json/hugeicons": "^1.2.33",
    "@iconify-json/lucide": "^1.2.127",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.94",
    "@iconify-json/tabler": "^1.2.38",
    "@mdx-js/rollup": "^3.1.1",
    "@solidjs/vite-plugin": "3.0.0-next.37",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "chrono-node": "^2.9.0",
    "estree-util-value-to-estree": "^3.5.0",
    "filesystem-routing": "^0.2.1",
    "mdast-util-to-string": "^4.0.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "rolldown": "1.2.4",
    "unified": "^11.0.5",
    "unist": "npm:@types/unist@^3.0.3",
    "unist-builder": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@kobalte/core": "2.0.0-alpha.1",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.21",
    "@solidjs/web": "2.0.0-rc.5",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-reactive-utils": "^8.6.0",
    "shiki": "^4.4.3",
    "solid-js": "2.0.0-rc.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
}
