{
  "name": "shadcn-solidjs",
  "version": "0.0.1",
  "description": "A set of beautifully designed components that you can customize, extend, and build on.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 3228",
    "build": "pnpm build:registry && vp build",
    "start": "wrangler dev --port 3228",
    "deploy": "pnpm build && wrangler deploy",
    "release": "changeset version",
    "build:registry": "node --import ./scripts/lib/alias.mjs src/scripts/build-icons.ts && node --import ./scripts/lib/alias.mjs src/scripts/build-registry.ts && node --import ./scripts/lib/alias.mjs src/scripts/build-docs-tokens.ts && vp fmt src/__registry__ src/registry/icons src/styles/style-docs.css",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test"
  },
  "dependencies": {
    "@kobalte/core": "2.0.0-alpha.4",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/prerender": "0.3.0",
    "@solidjs/router": "2.0.0-next.42",
    "@solidjs/web": "2.0.0-rc.18",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-reactive-utils": "^8.6.0",
    "postcss": "^8.5.26",
    "shiki": "^4.4.3",
    "solid-js": "2.0.0-rc.18",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@iconify-json/hugeicons": "^1.2.33",
    "@iconify-json/lucide": "^1.2.127",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.94",
    "@iconify-json/tabler": "^1.2.38",
    "@mdx-js/rollup": "^3.1.1",
    "@solidjs/vite-plugin": "3.0.0-next.51",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "chrono-node": "^2.9.0",
    "estree-util-value-to-estree": "^3.5.0",
    "filesystem-routing": "^0.4.0",
    "mdast-util-to-string": "^4.0.0",
    "prerender-crawler": "0.3.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist": "npm:@types/unist@^3.0.3",
    "unist-builder": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "unplugin-icons": "^23.0.1",
    "vite": "catalog:",
    "wrangler": "4.152.0"
  }
}
