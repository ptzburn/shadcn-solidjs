{
  // The package's only TypeScript config: tsdown's declaration build, the
  // type check and the editor all read it.
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.asynciterable", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    // Sources import siblings with explicit .ts/.tsx extensions.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "vite.config.ts", "tsdown.config.ts"]
}
