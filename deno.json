{
  "workspace": [
    "./apps/*",
    "./packages/*"
  ],
  "exclude": [
    "packages/cli/npm"
  ],
  "nodeModulesDir": "manual",
  "fmt": {
    "sortNamedImports": "caseInsensitive",
    "sortNamedExports": "caseInsensitive"
  },
  "lint": {
    "plugins": [
      "jsr:@ayk/lint-import-order",
      "jsr:@ryu/deno-lint-plugin-tailwindcss"
    ]
  },
  "tasks": {
    "dev": "deno task --cwd=apps/docs dev",
    "build": "deno task --cwd=apps/docs build",
    "start": "deno task --cwd=apps/docs start",
    "test": "deno test -A",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check ."
  },
  "imports": {
    "@solidjs/start": "npm:@solidjs/start@2.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "lefthook": "npm:lefthook@^2.1.10"
  },
  "allowScripts": [
    "npm:lefthook"
  ],
  "compilerOptions": {
    "paths": {
      "~icons/*": [
        "./node_modules/unplugin-icons/types/solid.d.ts"
      ]
    }
  }
}
