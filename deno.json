{
  "workspace": ["./apps/*", "./packages/*"],
  "nodeModulesDir": "manual",
  "tasks": {
    "dev": "deno task --cwd=apps/docs dev",
    "build": "deno task --cwd=apps/docs build",
    "test": "deno test -A",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check ."
  },
  "imports": {
    "@solidjs/start": "npm:@solidjs/start@2.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "compilerOptions": {
    "paths": {
      "~icons/*": [
        "./node_modules/unplugin-icons/types/solid.d.ts"
      ]
    }
  }
}
